APP_NAME="Nepal EMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://school.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Central database
# - PHP on your machine (Windows/Mac): DB_HOST=127.0.0.1, DB_PORT=POSTGRES_HOST_PORT (default 5433)
# - Docker app/scheduler: compose sets DB_HOST=postgres, DB_PORT=5432 (do not rely on these lines alone in containers)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=nems
DB_USERNAME=nems
DB_PASSWORD=secret

# Port published on your machine (DBeaver, host-run PHP). Default 5433 avoids clashing with local PostgreSQL on 5432.
POSTGRES_HOST_PORT=5433

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mailpit (host `mailpit` from app container; localhost when running PHP on host)
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@school.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Vite dev server (Docker: vite service on port 5173)
VITE_DEV_SERVER_HOST=0.0.0.0

# MinIO (optional future use; container runs but app uses local disk only)
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio_secret

AUTH_GUARD=web
